# A typical .env.example of a web app with an API and a database.
# Comments, blank lines and every quoting style the common loaders accept.

PORT=5173
export API_PORT = 8080
VITE_HOST=127.0.0.1   # trailing comment

DATABASE_URL="postgres://app:change-me@localhost:5432/app_dev"
REDIS_URL='redis://localhost:6379/0'
CACHE_DIR=`/tmp/app-cache`
PUBLIC_URL=https://example.test/#anchor
EMPTY=
SPACED = "  kept  "

MULTILINE_CERT="-----BEGIN CERTIFICATE-----
MIIB...
-----END CERTIFICATE-----"
AFTER_MULTILINE=1

UPLOAD_DIR=${DATA_ROOT}/uploads
LITERAL='${NOT_EXPANDED}'
ESCAPED="line\nnext \"quoted\""
not a variable line
=no key
